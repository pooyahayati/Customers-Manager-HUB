# Customers Manager HUB — Environment Template
# Copy to `.env` for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Customers Manager HUB
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_BASE_URL=http://localhost:3000
WEB_PORT=3000

# -----------------------------------------------------------------------------
# Security
# Generate strong random values for real environments.
# ENCRYPTION_KEY is used by Milestone 5 channel credential encryption and must
# be URL-safe base64 encoding of exactly 32 random bytes. Example generator:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# -----------------------------------------------------------------------------
APP_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL / pgvector
# -----------------------------------------------------------------------------
POSTGRES_DB=customers_manager_hub
POSTGRES_USER=cmh
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cmh:change-me@postgres:5432/customers_manager_hub

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# S3-compatible Object Storage
# Not required during the current bootstrap phase. Configure these when the
# file-storage milestone selects an active backend/provider.
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_USE_SSL=true

# -----------------------------------------------------------------------------
# AI Providers
# Milestone 4 uses these as platform-level live-provider credentials. Tenant task
# profiles store only provider/model routing configuration and never store keys.
# Leave blank when using deterministic mock-provider tests only.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Telegram
# Bot tokens and per-account webhook secrets are encrypted in PostgreSQL and are
# configured through the authenticated channel API. This value is only the
# externally reachable API origin used when registering Telegram webhooks.
# Telegram's hosted Bot API requires HTTPS for normal webhook deployments.
# -----------------------------------------------------------------------------
TELEGRAM_WEBHOOK_BASE_URL=

# -----------------------------------------------------------------------------
# Website Chat
# -----------------------------------------------------------------------------
WEB_CHAT_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Worker / Queue
# Channel inbound jobs use Redis Streams consumer groups (ADR-010).
# Broader concurrency/dead-letter production policy is finalized later.
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=customers-manager-hub
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Reverse proxy / TLS — optional for local development
# -----------------------------------------------------------------------------
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Development-only convenience flags
# Never rely on insecure defaults in production.
# -----------------------------------------------------------------------------
DEV_CREATE_DEFAULT_TENANT=false
DEV_SEED_DATA=false
