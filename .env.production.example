# Customers Manager HUB - Linux production environment template
#
# Copying this file is optional: scripts/install-linux.sh creates
# .env.production with generated secrets when it does not already exist.
# This template intentionally contains no real credentials.

# Public hostname and ACME registration contact. DNS must resolve to the server.
CMH_DOMAIN=hub.example.com
ACME_EMAIL=ops@example.com

# Compose isolation. Caddy is assigned the fixed address and is the only trusted
# HTTP proxy. Change both values together if this subnet conflicts on the host.
COMPOSE_PROJECT_NAME=cmh-production
CMH_DOCKER_SUBNET=172.30.0.0/24
CADDY_INTERNAL_IP=172.30.0.10
TRUSTED_PROXY_CIDRS=172.30.0.10/32
CADDY_IMAGE=caddy:2.10.2-alpine
CMH_POSTGRES_IMAGE=customers-manager-hub-production/postgres:18.6-pgvector0.8.6

# Application runtime.
APP_ENV=production
APP_NAME=Customers Manager HUB
APP_DEBUG=false
APP_LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_PUBLIC_REQUESTS=120
RATE_LIMIT_WEBHOOK_REQUESTS=180
WORKER_MAX_DELIVERY_ATTEMPTS=5
TELEGRAM_WEBHOOK_BASE_URL=https://hub.example.com

# Generated by the installer. Leave blank in templates and secret managers until
# a real deployment value is supplied.
ENCRYPTION_KEY=

# PostgreSQL / pgvector. The installer uses URL-safe hexadecimal credentials so
# DATABASE_URL does not require additional percent-encoding.
POSTGRES_DB=customers_manager_hub
POSTGRES_USER=cmh
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis is private to the production Compose network.
REDIS_URL=redis://redis:6379/0

# Single-host S3-compatible reference storage. The endpoint is not published to
# the host. External or multi-host S3 endpoints must use HTTPS instead.
S3_ENDPOINT_URL=http://object-storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=cmh-knowledge
S3_FORCE_PATH_STYLE=true
S3_ALLOW_INSECURE_INTERNAL_ENDPOINT=true

# Optional provider fallbacks; normally configured encrypted in the Owner UI.
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Used once by the real bootstrap CLI and retained only in this mode-0600 file.
BOOTSTRAP_TENANT_NAME=Example Business
BOOTSTRAP_TENANT_SLUG=example-business
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=
